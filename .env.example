# Copy to .env.local. Replace with an authorized DEVELOPMENT project and public key.
# These deliberately non-production placeholders do not create a working backend.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-development-publishable-key
# If using the legacy VITE_SUPABASE_ANON_KEY alias, it must belong to the same project.
# Paid-provider keys belong only in approved server configuration, never VITE_*.
